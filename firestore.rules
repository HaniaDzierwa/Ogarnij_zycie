rules_version = '2';

// Reguły Firestore – „Ogarnij życie” (etap 2). Model danych: docs/DESIGN.md → „Model danych”.
// Zasady: bez logowania nic; profil widzi tylko właściciel; dane domu – tylko domownicy;
// dom zakłada się tylko dla siebie; każda zmiana podpisana zalogowanym użytkownikiem (updatedBy)
// i czasem serwera (updatedAt); poprawne typy i limity (src/firebase/model.ts → LIMITS).
// Testy: tests/rules/firestore.rules.test.ts (`npm run test:reguly`, emulator – Java 21).
// Etap 4: zaproszenia i dołączanie; „Tylko ja” (prywatne zadania i wydarzenia); dalej – usuwanie domowników.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Pomocnicze ──────────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function memberPath(houseId) {
      return /databases/$(database)/documents/houses/$(houseId)/members/$(request.auth.uid);
    }

    /** Odczyt: domownik tego domu. */
    function isMember(houseId) {
      return signedIn() && exists(memberPath(houseId));
    }

    /** Zapis: domownik po zapisie (pozwala zapisać dane nowego domu w tej samej paczce). */
    function isMemberAfter(houseId) {
      return signedIn() && existsAfter(memberPath(houseId));
    }

    /** Dom powstaje w tej samej paczce (writeBatch „Załóż nowy dom”). */
    function houseCreatedNow(houseId) {
      return !exists(/databases/$(database)/documents/houses/$(houseId))
        && existsAfter(/databases/$(database)/documents/houses/$(houseId));
    }

    function str(v, max) {
      return v is string && v.size() <= max;
    }

    function text(v, max) {
      return str(v, max) && v.size() > 0;
    }

    function strOrNull(v, max) {
      return v == null || str(v, max);
    }

    function tsOrNull(v) {
      return v == null || v is timestamp;
    }

    function isDay(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isTime(v) {
      return v is string && v.matches('^[0-9]{2}:[0-9]{2}$');
    }

    /** Zmianę podpisuje zalogowany użytkownik, a czas ustawia serwer. */
    function signed(d) {
      return d.updatedBy == me() && d.updatedAt == request.time;
    }

    /** Kto dodał – przy tworzeniu to ja, później bez zmian. */
    function author(d) {
      return request.method == 'create' ? d.createdBy == me() : d.createdBy == resource.data.createdBy;
    }

    // ── Walidacja dokumentów domu ───────────────────────────────────────────

    function validCategory(d) {
      return d.keys().hasOnly(['name', 'color', 'order', 'updatedAt', 'updatedBy'])
        && text(d.name, 40)
        && str(d.color, 30)
        && d.order is int
        && signed(d);
    }

    // Własny priorytet (wbudowane Pilne · Ważne · Przy okazji są w aplikacji). `order` – miejsce
    // w kolejności, także ułamek (wstawiony między dwa inne).
    function validPriority(d) {
      return d.keys().hasOnly(['name', 'color', 'order', 'updatedAt', 'updatedBy'])
        && text(d.name, 40)
        && str(d.color, 30)
        && d.order is number
        && signed(d);
    }

    function validSubtasks(list) {
      return list is list && list.size() <= 50;
    }

    function validTask(d) {
      return d.keys().hasOnly(['title', 'categoryId', 'priority', 'due', 'done', 'subtasks', 'note',
          'createdBy', 'doneAt', 'doneBy', 'deleted', 'deletedAt', 'deletedBy', 'updatedAt', 'updatedBy'])
        && text(d.title, 200)
        && strOrNull(d.categoryId, 100)
        // wbudowany (high / mid / low) albo id własnego priorytetu
        && text(d.priority, 100)
        && (d.due == null || isDay(d.due))
        && d.done is bool
        && validSubtasks(d.subtasks)
        // notatka (od 2026-10-20) – starsze zadania mogą jej nie mieć
        && (!('note' in d) || str(d.note, 500))
        && author(d)
        && tsOrNull(d.doneAt)
        && strOrNull(d.doneBy, 128)
        && d.deleted is bool
        && tsOrNull(d.deletedAt)
        && strOrNull(d.deletedBy, 128)
        && signed(d);
    }

    function validEventType(d) {
      return d.keys().hasOnly(['name', 'dot', 'bg', 'fg', 'icon', 'system', 'updatedAt', 'updatedBy'])
        && text(d.name, 40)
        && str(d.dot, 30) && str(d.bg, 30) && str(d.fg, 30)
        && d.icon in ['deadline', 'bday', 'party', 'event', 'custom']
        && d.system is bool
        && signed(d);
    }

    function validEvent(d) {
      return d.keys().hasOnly(['title', 'date', 'allDay', 'from', 'to', 'typeId', 'remind', 'createdBy',
          'note', 'deleted', 'deletedAt', 'deletedBy', 'updatedAt', 'updatedBy'])
        && text(d.title, 200)
        && isDay(d.date)
        && d.allDay is bool
        && (d.from == null || isTime(d.from))
        && (d.to == null || isTime(d.to))
        && text(d.typeId, 100)
        && d.remind in ['none', 'day', 'week']
        && author(d)
        && str(d.note, 500)
        && d.deleted is bool
        && tsOrNull(d.deletedAt)
        && strOrNull(d.deletedBy, 128)
        && signed(d);
    }

    // ── Zaproszenia ─────────────────────────────────────────────────────────

    function invitePath(code) {
      return /databases/$(database)/documents/invites/$(code);
    }

    /** Zaproszenie ważne 10 minut od utworzenia (czas serwera). */
    function inviteFresh(inv) {
      return request.time < inv.createdAt + duration.value(10, 'm');
    }

    function validScope(s) {
      return s is map
        && s.keys().hasOnly(['all', 'categoryIds', 'calendar'])
        && s.all is bool
        && s.categoryIds is list && s.categoryIds.size() <= 50
        && s.calendar is bool;
    }

    /**
     * Dołączenie: dokument domownika wskazuje kod; zaproszenie jest do tego domu, przed paczką nieużyte,
     * po paczce użyte przeze mnie, jeszcze ważne; rola „member”, zakres taki jak w zaproszeniu.
     */
    function joinedByInvite(houseId, d) {
      let code = d.invite;
      let before = get(invitePath(code)).data;
      let after = getAfter(invitePath(code)).data;
      return d.keys().hasOnly(['name', 'role', 'scope', 'joinedAt', 'invite'])
        && code is string
        && before.houseId == houseId
        && before.usedBy == null
        && after.usedBy == me()
        && inviteFresh(before)
        && str(d.name, 40)
        && d.role == 'member'
        && d.scope == before.scope
        && d.joinedAt == request.time;
    }

    match /invites/{code} {
      // znając kod, zalogowany zobaczy „Znaleziono dom”; listy zaproszeń nikt nie przegląda
      allow get: if signedIn();
      allow list: if false;

      // zaprasza domownik – do swojego domu, jako on sam
      allow create: if signedIn()
        && code.matches('^[0-9]{6}$')
        && isMember(request.resource.data.houseId)
        && request.resource.data.keys().hasOnly(['houseId', 'houseName', 'createdBy', 'inviterName',
            'memberNames', 'createdAt', 'scope', 'usedBy', 'usedAt'])
        && request.resource.data.createdBy == me()
        && request.resource.data.createdAt == request.time
        && text(request.resource.data.houseName, 40)
        && str(request.resource.data.inviterName, 40)
        && request.resource.data.memberNames is list
        && request.resource.data.memberNames.size() <= 20
        && validScope(request.resource.data.scope)
        && request.resource.data.usedBy == null
        && request.resource.data.usedAt == null;

      // użycie – raz, w ciągu 10 minut, przez kogoś spoza domu, razem z dopisaniem siebie jako domownika
      allow update: if signedIn()
        && resource.data.usedBy == null
        && inviteFresh(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
        && request.resource.data.usedBy == me()
        && request.resource.data.usedAt == request.time
        && !isMember(resource.data.houseId)
        && existsAfter(/databases/$(database)/documents/houses/$(resource.data.houseId)/members/$(request.auth.uid));

      // „Nowy kod” / „Anuluj zaproszenie” – zapraszający usuwa swoje zaproszenie
      allow delete: if signedIn() && resource.data.createdBy == me();
    }

    // ── Profil ──────────────────────────────────────────────────────────────

    function validUser(d) {
      return d.keys().hasOnly(['name', 'houseId', 'notif', 'cleanupDays', 'taskReminderTime'])
        && str(d.name, 40)
        && (d.houseId == null || (d.houseId is string && existsAfter(
             /databases/$(database)/documents/houses/$(d.houseId)/members/$(request.auth.uid))))
        && d.notif is map
        && d.notif.keys().hasOnly(['tasks', 'events', 'morning', 'house'])
        && d.notif.tasks is bool && d.notif.events is bool
        && d.notif.morning is bool && d.notif.house is bool
        && d.cleanupDays in [7, 30, null]
        && isTime(d.taskReminderTime);
    }

    match /users/{uid} {
      allow read: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid && validUser(request.resource.data);
      allow delete: if false; // etap 7 – usuwanie konta
    }

    // ── Dom ─────────────────────────────────────────────────────────────────

    match /houses/{houseId} {
      allow read: if isMember(houseId);

      // „Załóż nowy dom” – tylko dla siebie i razem ze sobą jako domownikiem
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'createdAt'])
        && text(request.resource.data.name, 40)
        && request.resource.data.ownerUid == me()
        && request.resource.data.createdAt == request.time
        && existsAfter(memberPath(houseId));

      // domownicy mogą zmienić tylko nazwę
      allow update: if isMember(houseId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && text(request.resource.data.name, 40);

      allow delete: if false; // etap 7

      // ── Domownicy ─────────────────────────────────────────────────────────

      match /members/{uid} {
        allow read: if isMember(houseId);

        // założyciel – przy zakładaniu domu
        allow create: if signedIn() && uid == me()
          && houseCreatedNow(houseId)
          && getAfter(/databases/$(database)/documents/houses/$(houseId)).data.ownerUid == me()
          && request.resource.data.keys().hasOnly(['name', 'role', 'scope', 'joinedAt'])
          && str(request.resource.data.name, 40)
          && request.resource.data.role == 'owner'
          && request.resource.data.scope == { 'all': true, 'categoryIds': [], 'calendar': true }
          && request.resource.data.joinedAt == request.time;

        // nowy domownik – tylko z ważnym zaproszeniem do tego domu, użytym w tej samej paczce
        allow create: if signedIn() && uid == me()
          && joinedByInvite(houseId, request.resource.data);

        // każdy zmienia tylko swoje imię
        allow update: if isMember(houseId) && uid == me()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && str(request.resource.data.name, 40);

        allow delete: if false; // etap 4
      }

      // ── Kategorie ─────────────────────────────────────────────────────────

      match /categories/{id} {
        allow read: if isMember(houseId);
        allow create, update: if isMemberAfter(houseId) && validCategory(request.resource.data);
        allow delete: if isMember(houseId);
      }

      // ── Własne priorytety ─────────────────────────────────────────────────

      match /priorities/{id} {
        allow read: if isMember(houseId);
        allow create, update: if isMemberAfter(houseId) && validPriority(request.resource.data);
        allow delete: if isMember(houseId);
      }

      // ── Zadania (kosz: deleted = true) ────────────────────────────────────

      match /tasks/{id} {
        allow read: if isMember(houseId);
        allow create, update: if isMemberAfter(houseId) && validTask(request.resource.data);
        // na zawsze – tylko z kosza („Opróżnij kosz”); autor – także przeniesienie do „Tylko ja”
        allow delete: if isMember(houseId)
          && (resource.data.deleted == true || resource.data.createdBy == me());
      }

      // ── Rodzaje wydarzeń ──────────────────────────────────────────────────

      match /eventTypes/{id} {
        allow read: if isMember(houseId);
        allow create: if isMemberAfter(houseId) && validEventType(request.resource.data)
          // wbudowane systemowe („Termin zadania”) – tylko przy zakładaniu domu
          && (request.resource.data.system == false || houseCreatedNow(houseId));
        allow update: if isMember(houseId) && validEventType(request.resource.data)
          && request.resource.data.system == resource.data.system;
        allow delete: if isMember(houseId) && resource.data.system == false;
      }

      // ── Wydarzenia (kosz: deleted = true) ─────────────────────────────────

      match /events/{id} {
        allow read: if isMember(houseId);
        allow create, update: if isMemberAfter(houseId) && validEvent(request.resource.data);
        allow delete: if isMember(houseId)
          && (resource.data.deleted == true || resource.data.createdBy == me());
      }

      // ── „Tylko ja”: zadania i wydarzenia widoczne tylko dla autora (decyzja Hani 2026-10-25) ──
      // Zapisuje, czyta i usuwa wyłącznie sam autor, dopóki jest domownikiem; inni domownicy nie widzą.

      match /private/{uid}/tasks/{id} {
        allow read, delete: if isMember(houseId) && uid == me();
        allow create, update: if isMemberAfter(houseId) && uid == me()
          && validTask(request.resource.data) && request.resource.data.createdBy == me();
      }

      match /private/{uid}/events/{id} {
        allow read, delete: if isMember(houseId) && uid == me();
        allow create, update: if isMemberAfter(houseId) && uid == me()
          && validEvent(request.resource.data) && request.resource.data.createdBy == me();
      }
    }

  }
}
