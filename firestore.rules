rules_version = '2';

// Reguły Firestore – „Ogarnij życie” (etap 2). Model danych: docs/DESIGN.md → „Model danych”.
// Zasady: bez logowania nic; profil widzi tylko właściciel; dane domu – tylko domownicy;
// dom zakłada się tylko dla siebie; każda zmiana podpisana zalogowanym użytkownikiem (updatedBy)
// i czasem serwera (updatedAt); poprawne typy i limity (src/firebase/model.ts → LIMITS).
// Testy: tests/rules/firestore.rules.test.ts (`npm run test:reguly`, emulator – Java 21).
// Etap 4: zaproszenia i dołączanie; „Tylko ja” (prywatne zadania i wydarzenia); „Opuść dom” i „Usuń z domu”.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Pomocnicze ──────────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function memberPath(houseId) {
      return /databases/$(database)/documents/houses/$(houseId)/members/$(request.auth.uid);
    }

    /** Odczyt: domownik tego domu. */
    function isMember(houseId) {
      return signedIn() && exists(memberPath(houseId));
    }

    /** Założyciel domu (usuwanie domu przy usuwaniu konta, przekazanie domu). */
    function isOwner(houseId) {
      return signedIn()
        && get(/databases/$(database)/documents/houses/$(houseId)).data.ownerUid == me();
    }

    /** Zapis: domownik po zapisie (pozwala zapisać dane nowego domu w tej samej paczce). */
    function isMemberAfter(houseId) {
      return signedIn() && existsAfter(memberPath(houseId));
    }

    /** Dom powstaje w tej samej paczce (writeBatch „Załóż nowy dom”). */
    function houseCreatedNow(houseId) {
      return !exists(/databases/$(database)/documents/houses/$(houseId))
        && existsAfter(/databases/$(database)/documents/houses/$(houseId));
    }

    function str(v, max) {
      return v is string && v.size() <= max;
    }

    function text(v, max) {
      return str(v, max) && v.size() > 0;
    }

    function strOrNull(v, max) {
      return v == null || str(v, max);
    }

    function tsOrNull(v) {
      return v == null || v is timestamp;
    }

    function isDay(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isTime(v) {
      return v is string && v.matches('^[0-9]{2}:[0-9]{2}$');
    }

    /** Zmianę podpisuje zalogowany użytkownik, a czas ustawia serwer. */
    function signed(d) {
      return d.updatedBy == me() && d.updatedAt == request.time;
    }

    /** Kto dodał – przy tworzeniu to ja, później bez zmian. */
    function author(d) {
      return request.method == 'create' ? d.createdBy == me() : d.createdBy == resource.data.createdBy;
    }

    // ── Walidacja dokumentów domu ───────────────────────────────────────────

    function validCategory(d) {
      return d.keys().hasOnly(['name', 'color', 'order', 'updatedAt', 'updatedBy'])
        && text(d.name, 40)
        && str(d.color, 30)
        && d.order is int
        && signed(d);
    }

    // Własny priorytet (wbudowane Pilne · Ważne · Przy okazji są w aplikacji). `order` – miejsce
    // w kolejności, także ułamek (wstawiony między dwa inne).
    function validPriority(d) {
      return d.keys().hasOnly(['name', 'color', 'order', 'updatedAt', 'updatedBy'])
        && text(d.name, 40)
        && str(d.color, 30)
        && d.order is number
        && signed(d);
    }

    function validSubtasks(list) {
      return list is list && list.size() <= 50;
    }

    // Powtarzanie (etap 8, 2026-11-15): { every, n } – n (2–365) tylko przy „co X dni”
    function validRepeat(r) {
      return r is map
        && r.keys().hasOnly(['every', 'n'])
        && r.every in ['day', 'week', 'month', 'year', 'days']
        && (r.every == 'days'
          ? ('n' in r && r.n is int && r.n >= 2 && r.n <= 365)
          : !('n' in r));
    }

    function validTask(d) {
      return d.keys().hasOnly(['title', 'categoryId', 'priority', 'due', 'dueWeek', 'repeat', 'done',
          'subtasks', 'note', 'createdBy', 'doneAt', 'doneBy', 'deleted', 'deletedAt', 'deletedBy',
          'updatedAt', 'updatedBy'])
        && text(d.title, 200)
        && strOrNull(d.categoryId, 100)
        // wbudowany (high / mid / low) albo id własnego priorytetu
        && text(d.priority, 100)
        && (d.due == null || isDay(d.due))
        // „W tym / w przyszłym tygodniu” (od 2026-11-15) – tylko przy terminie; starsze go nie mają
        && (!('dueWeek' in d) || (d.dueWeek is bool && d.due != null))
        // zadanie cykliczne – tylko przy terminie; starsze go nie mają
        && (!('repeat' in d) || (validRepeat(d.repeat) && d.due != null))
        // zdjęcia (etap 9): seria, liczba i miniatura na listę – starsze zadania ich nie mają
        && (!('seriesId' in d) || text(d.seriesId, 100))
        && (!('photos' in d) || (d.photos is int && d.photos >= 0 && d.photos <= 10))
        && (!('thumb' in d) || (d.thumb is bytes && d.thumb.size() <= 8000))
        && d.done is bool
        && validSubtasks(d.subtasks)
        // notatka (od 2026-10-20) – starsze zadania mogą jej nie mieć
        && (!('note' in d) || str(d.note, 500))
        && author(d)
        && tsOrNull(d.doneAt)
        && strOrNull(d.doneBy, 128)
        && d.deleted is bool
        && tsOrNull(d.deletedAt)
        && strOrNull(d.deletedBy, 128)
        && signed(d);
    }

    function validEventType(d) {
      return d.keys().hasOnly(['name', 'dot', 'bg', 'fg', 'icon', 'system', 'updatedAt', 'updatedBy'])
        && text(d.name, 40)
        && str(d.dot, 30) && str(d.bg, 30) && str(d.fg, 30)
        && d.icon in ['deadline', 'bday', 'party', 'event', 'custom']
        && d.system is bool
        && signed(d);
    }

    function validEvent(d) {
      return d.keys().hasOnly(['title', 'date', 'allDay', 'from', 'to', 'typeId', 'remind', 'repeat',
          'skip', 'createdBy', 'note', 'deleted', 'deletedAt', 'deletedBy', 'updatedAt', 'updatedBy'])
        && text(d.title, 200)
        && isDay(d.date)
        && d.allDay is bool
        && (d.from == null || isTime(d.from))
        && (d.to == null || isTime(d.to))
        && text(d.typeId, 100)
        && d.remind in ['none', 'day', 'week']
        // wydarzenie cykliczne (etap 8) i pominięte powtórki – tylko przy powtarzaniu
        && (!('repeat' in d) || validRepeat(d.repeat))
        && (!('skip' in d) || ('repeat' in d && d.skip is list && d.skip.size() <= 200))
        && author(d)
        && str(d.note, 500)
        && d.deleted is bool
        && tsOrNull(d.deletedAt)
        && strOrNull(d.deletedBy, 128)
        && signed(d);
    }

    // ── Zdjęcia (etap 9, docs/PLAN.md) ──────────────────────────────────────
    // Zdjęcie = kafelek z opisem (photos/{id}) + pełna wersja (photoFull/{id}); „Tylko ja” – to samo
    // w private/{uid}/. Każde dodanie / usunięcie zmienia w tej samej paczce dwa liczniki miejsca:
    // domu (photoBytes ≤ 150 MB) i całej aplikacji (meta/photos ≤ 600 MB), dokładnie o rozmiar
    // zdjęcia, i wskazuje je (photoOp / op). Limit 5 zdjęć: stałe miejsca – id {zadanie}_0…4
    // („tylko tym razem”) i {seria}_s0…4 („przy każdym powtórzeniu”); razem 5 pilnuje aplikacja.
    // Liczba odczytów w regułach jest ograniczona – dlatego bez zbędnych exists / get.

    function housePath(houseId) {
      return /databases/$(database)/documents/houses/$(houseId);
    }

    function metaPath() {
      return /databases/$(database)/documents/meta/photos;
    }

    /** uid '' – wspólne; inaczej „Tylko ja” tego domownika. */
    function photoPath(houseId, uid, id) {
      return uid == ''
        ? /databases/$(database)/documents/houses/$(houseId)/photos/$(id)
        : /databases/$(database)/documents/houses/$(houseId)/private/$(uid)/photos/$(id);
    }

    function fullPath(houseId, uid, id) {
      return uid == ''
        ? /databases/$(database)/documents/houses/$(houseId)/photoFull/$(id)
        : /databases/$(database)/documents/houses/$(houseId)/private/$(uid)/photoFull/$(id);
    }

    function taskExistsAfter(houseId, uid, taskId) {
      return uid == ''
        ? existsAfter(/databases/$(database)/documents/houses/$(houseId)/tasks/$(taskId))
        : existsAfter(/databases/$(database)/documents/houses/$(houseId)/private/$(uid)/tasks/$(taskId));
    }

    /** Kształt zdjęcia; rozmiar = kafelek + pełna wersja zapisana w tej samej paczce. */
    function validPhoto(houseId, uid, id, d) {
      return d.keys().hasOnly(['kind', 'taskId', 'seriesId', 'slot', 'type', 'tile', 'size',
          'createdBy', 'createdAt'])
        && d.slot is int && d.slot >= 0 && d.slot < 5
        && (d.kind == 'task'
          ? (text(d.taskId, 100) && !('seriesId' in d)
            && id == d.taskId + '_' + string(d.slot)
            && taskExistsAfter(houseId, uid, d.taskId))
          : (d.kind == 'series' && text(d.seriesId, 100) && !('taskId' in d)
            && id == d.seriesId + '_s' + string(d.slot)))
        && d.type in ['image/webp', 'image/jpeg']
        && d.tile is bytes && d.tile.size() <= 60000
        && d.size == d.tile.size() + getAfter(fullPath(houseId, uid, id)).data.full.size()
        && d.createdAt is timestamp;
    }

    function validFull(d) {
      return d.keys().hasOnly(['full']) && d.full is bytes && d.full.size() <= 700000;
    }

    /** Licznik przed / po paczce (stary dom albo brak licznika aplikacji = 0). */
    function appBytesBefore() {
      return exists(metaPath()) ? get(metaPath()).data.photoBytes : 0;
    }

    /** Oba liczniki zmienione o `delta` i wskazują to zdjęcie. */
    function countersMoved(houseId, uid, id, delta) {
      let h = getAfter(housePath(houseId)).data;
      let m = getAfter(metaPath()).data;
      return h.photoBytes == get(housePath(houseId)).data.get('photoBytes', 0) + delta
        && h.photoOp == { 'uid': uid, 'id': id }
        && m.photoBytes == appBytesBefore() + delta
        && m.op == { 'house': houseId, 'uid': uid, 'id': id };
    }

    /** W tej paczce zdjęcie powstaje (delta > 0) albo znika (delta < 0) – dokładnie tej wielkości. */
    // Przeniesienie (movedIn / movedOut) nie zmienia liczników – dlatego drugie miejsce (wspólne ↔
    // „Tylko ja”) musi zostać puste.
    function photoOpDone(houseId, uid, id, delta) {
      let p = photoPath(houseId, uid, id);
      let other = photoPath(houseId, uid == '' ? me() : '', id);
      return (uid == '' || uid == me())
        && (delta > 0
          ? (!exists(p) && !exists(other) && getAfter(p).data.size == delta)
          : (!existsAfter(p) && !existsAfter(other) && get(p).data.size == -delta));
    }

    /** Przeniesienie między „Wspólne” a „Tylko ja”: to samo zdjęcie znika ze starego miejsca. */
    function movedIn(houseId, fromUid, id, d) {
      let s = get(photoPath(houseId, fromUid, id)).data;
      return !existsAfter(photoPath(houseId, fromUid, id))
        && s.size == d.size && s.kind == d.kind && s.createdBy == d.createdBy
        && s.createdAt == d.createdAt;
    }

    function movedOut(houseId, toUid, id) {
      return !exists(photoPath(houseId, toUid, id))
        && getAfter(photoPath(houseId, toUid, id)).data.size == resource.data.size;
    }

    /** Usuwanie domu: założyciel wyzerował licznik domu („closing”) – zdjęcia bez liczenia. */
    function houseClosing(houseId) {
      return isOwner(houseId)
        && get(housePath(houseId)).data.get('photoOp', null) == { 'closing': true };
    }

    /** Licznik aplikacji: zmiana tylko razem ze zdjęciem albo przy usuwaniu domu. */
    function validUsage(before, d) {
      return d.keys().hasOnly(['photoBytes', 'op'])
        && d.photoBytes is int && d.photoBytes >= 0 && d.photoBytes <= 629145600
        && d.op is map
        && (d.op.keys().hasOnly(['house', 'uid', 'id'])
          ? photoOpDone(d.op.house, d.op.uid, d.op.id, d.photoBytes - before)
          : (d.op.keys().hasOnly(['house', 'closing']) && d.op.closing == true
            && isOwner(d.op.house)
            && before - d.photoBytes == get(housePath(d.op.house)).data.get('photoBytes', 0)
            && getAfter(housePath(d.op.house)).data.photoBytes == 0));
    }

    match /meta/photos {
      // „Miejsce na zdjęcia w aplikacji się skończyło” – zalogowany widzi tylko sumę
      allow read: if signedIn();
      allow create: if signedIn() && validUsage(0, request.resource.data);
      allow update: if signedIn() && validUsage(resource.data.photoBytes, request.resource.data);
      allow delete: if false;
    }

    // ── Zaproszenia ─────────────────────────────────────────────────────────

    function invitePath(code) {
      return /databases/$(database)/documents/invites/$(code);
    }

    /** Zaproszenie ważne 10 minut od utworzenia (czas serwera). */
    function inviteFresh(inv) {
      return request.time < inv.createdAt + duration.value(10, 'm');
    }

    function validScope(s) {
      return s is map
        && s.keys().hasOnly(['all', 'categoryIds', 'calendar'])
        && s.all is bool
        && s.categoryIds is list && s.categoryIds.size() <= 50
        && s.calendar is bool;
    }

    /**
     * Dołączenie: dokument domownika wskazuje kod; zaproszenie jest do tego domu, przed paczką nieużyte,
     * po paczce użyte przeze mnie, jeszcze ważne; rola „member”, zakres taki jak w zaproszeniu.
     */
    function joinedByInvite(houseId, d) {
      let code = d.invite;
      let before = get(invitePath(code)).data;
      let after = getAfter(invitePath(code)).data;
      return d.keys().hasOnly(['name', 'role', 'scope', 'joinedAt', 'invite'])
        && code is string
        && before.houseId == houseId
        && before.usedBy == null
        && after.usedBy == me()
        && inviteFresh(before)
        && str(d.name, 40)
        && d.role == 'member'
        && d.scope == before.scope
        && d.joinedAt == request.time;
    }

    match /invites/{code} {
      // znając kod, zalogowany zobaczy „Znaleziono dom”; listy zaproszeń nikt nie przegląda
      allow get: if signedIn();
      allow list: if false;

      // zaprasza domownik – do swojego domu, jako on sam
      allow create: if signedIn()
        && code.matches('^[0-9]{6}$')
        && isMember(request.resource.data.houseId)
        && request.resource.data.keys().hasOnly(['houseId', 'houseName', 'createdBy', 'inviterName',
            'memberNames', 'createdAt', 'scope', 'usedBy', 'usedAt'])
        && request.resource.data.createdBy == me()
        && request.resource.data.createdAt == request.time
        && text(request.resource.data.houseName, 40)
        && str(request.resource.data.inviterName, 40)
        && request.resource.data.memberNames is list
        && request.resource.data.memberNames.size() <= 20
        && validScope(request.resource.data.scope)
        && request.resource.data.usedBy == null
        && request.resource.data.usedAt == null;

      // użycie – raz, w ciągu 10 minut, przez kogoś spoza domu, razem z dopisaniem siebie jako domownika
      allow update: if signedIn()
        && resource.data.usedBy == null
        && inviteFresh(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
        && request.resource.data.usedBy == me()
        && request.resource.data.usedAt == request.time
        && !isMember(resource.data.houseId)
        && existsAfter(/databases/$(database)/documents/houses/$(resource.data.houseId)/members/$(request.auth.uid));

      // „Nowy kod” / „Anuluj zaproszenie” – zapraszający usuwa swoje zaproszenie
      allow delete: if signedIn() && resource.data.createdBy == me();
    }

    // ── Profil ──────────────────────────────────────────────────────────────

    function validUser(d) {
      return d.keys().hasOnly(['name', 'houseId', 'notif', 'cleanupDays', 'taskReminderTime',
          'summaryTimes', 'summaryContent'])
        && str(d.name, 40)
        && (d.houseId == null || (d.houseId is string && existsAfter(
             /databases/$(database)/documents/houses/$(d.houseId)/members/$(request.auth.uid))))
        && d.notif is map
        && d.notif.keys().hasOnly(['tasks', 'events', 'morning', 'house'])
        && d.notif.tasks is bool && d.notif.events is bool
        && d.notif.morning is bool && d.notif.house is bool
        && d.cleanupDays in [7, 30, null]
        && isTime(d.taskReminderTime)
        // godziny podsumowań (decyzja Hani 2026-10-30): lista, najwyżej 5; stare konta – bez pola
        && (!('summaryTimes' in d) || (d.summaryTimes is list && d.summaryTimes.size() <= 5))
        && (!('summaryContent' in d) || validSummaryContent(d.summaryContent));
    }

    /** Co przychodzi w podsumowaniach: pięć pól prawda / fałsz. */
    function validSummaryContent(c) {
      return c is map
        && c.keys().hasOnly(['urgent', 'dueToday', 'dueTomorrow', 'eventsToday', 'eventsSoon'])
        && c.urgent is bool && c.dueToday is bool && c.dueTomorrow is bool
        && c.eventsToday is bool && c.eventsSoon is bool;
    }

    match /users/{uid} {
      allow read: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid && validUser(request.resource.data);
      // usuwanie konta (decyzja Hani 2026-10-25) – tylko własny profil
      allow delete: if signedIn() && me() == uid;

      // Powiadomienia (etap 6): subskrypcje telefonów – tylko właściciel konta; Worker czyta
      // je kontem serwisowym (poza regułami).
      match /push/{id} {
        allow read, delete: if signedIn() && me() == uid;
        allow create, update: if signedIn() && me() == uid
          && request.resource.data.keys().hasOnly(['endpoint', 'keys', 'userAgent', 'createdAt'])
          && text(request.resource.data.endpoint, 1000)
          && request.resource.data.endpoint.matches('https://.*')
          // pole „keys” – przez nawias (keys() to też funkcja mapy)
          && request.resource.data['keys'] is map
          && request.resource.data['keys'].keys().hasOnly(['p256dh', 'auth'])
          && str(request.resource.data['keys'].p256dh, 200)
          && str(request.resource.data['keys'].auth, 100)
          && str(request.resource.data.userAgent, 300)
          && request.resource.data.createdAt == request.time;
      }
    }

    // ── Dom ─────────────────────────────────────────────────────────────────

    match /houses/{houseId} {
      allow read: if isMember(houseId);

      // „Załóż nowy dom” – tylko dla siebie i razem ze sobą jako domownikiem
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'createdAt'])
        && text(request.resource.data.name, 40)
        && request.resource.data.ownerUid == me()
        && request.resource.data.createdAt == request.time
        && existsAfter(memberPath(houseId));

      // domownicy mogą zmienić tylko nazwę
      allow update: if isMember(houseId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && text(request.resource.data.name, 40);

      // przekazanie domu (usuwanie konta założyciela): nowy właściciel to domownik, który w tej
      // samej paczce dostaje rolę „owner”
      allow update: if isMember(houseId)
        && resource.data.ownerUid == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid'])
        && request.resource.data.ownerUid != me()
        && getAfter(/databases/$(database)/documents/houses/$(houseId)/members/$(request.resource.data.ownerUid)).data.role == 'owner';

      // licznik miejsca na zdjęcia (etap 9): tylko razem z dodaniem / usunięciem zdjęcia w tej
      // samej paczce; najwyżej 150 MB na dom
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['photoBytes', 'photoOp'])
        && request.resource.data.photoBytes is int
        && request.resource.data.photoBytes >= 0
        && request.resource.data.photoBytes <= 157286400
        && request.resource.data.photoOp is map
        && request.resource.data.photoOp.keys().hasOnly(['uid', 'id'])
        && photoOpDone(houseId, request.resource.data.photoOp.uid, request.resource.data.photoOp.id,
            request.resource.data.photoBytes - resource.data.get('photoBytes', 0));

      // usuwanie domu: założyciel zeruje licznik razem z licznikiem aplikacji (closeHousePhotosOps)
      allow update: if isOwner(houseId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoBytes', 'photoOp'])
        && request.resource.data.photoBytes == 0
        && request.resource.data.photoOp == { 'closing': true }
        && getAfter(metaPath()).data.op == { 'house': houseId, 'closing': true };

      // usunięcie domu (usuwanie konta założyciela, „usuń dom u wszystkich”)
      allow delete: if isOwner(houseId);

      // ── Domownicy ─────────────────────────────────────────────────────────

      match /members/{uid} {
        allow read: if isMember(houseId);

        // założyciel – przy zakładaniu domu
        allow create: if signedIn() && uid == me()
          && houseCreatedNow(houseId)
          && getAfter(/databases/$(database)/documents/houses/$(houseId)).data.ownerUid == me()
          && request.resource.data.keys().hasOnly(['name', 'role', 'scope', 'joinedAt'])
          && str(request.resource.data.name, 40)
          && request.resource.data.role == 'owner'
          && request.resource.data.scope == { 'all': true, 'categoryIds': [], 'calendar': true }
          && request.resource.data.joinedAt == request.time;

        // nowy domownik – tylko z ważnym zaproszeniem do tego domu, użytym w tej samej paczce
        allow create: if signedIn() && uid == me()
          && joinedByInvite(houseId, request.resource.data);

        // każdy zmienia tylko swoje imię
        allow update: if isMember(houseId) && uid == me()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && str(request.resource.data.name, 40);

        // przekazanie domu: założyciel nadaje innemu domownikowi rolę „owner” razem ze zmianą
        // właściciela domu (ta sama paczka)
        allow update: if isOwner(houseId) && uid != me()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role == 'owner'
          && getAfter(/databases/$(database)/documents/houses/$(houseId)).data.ownerUid == uid;

        // „Opuść dom” – każdy sam siebie; „Usuń z domu” – tylko założyciel, innego domownika
        // (decyzje Hani 2026-10-18 i 2026-10-25). Założyciel wychodzi tylko z pustego domu – pilnuje aplikacja.
        allow delete: if isMember(houseId)
          && (uid == me()
            || get(/databases/$(database)/documents/houses/$(houseId)).data.ownerUid == me());
      }

      // ── Kategorie ─────────────────────────────────────────────────────────

      match /categories/{id} {
        allow read: if isMember(houseId);
        allow create, update: if isMemberAfter(houseId) && validCategory(request.resource.data);
        allow delete: if isMember(houseId);
      }

      // ── Własne priorytety ─────────────────────────────────────────────────

      match /priorities/{id} {
        allow read: if isMember(houseId);
        allow create, update: if isMemberAfter(houseId) && validPriority(request.resource.data);
        allow delete: if isMember(houseId);
      }

      // ── Zadania (kosz: deleted = true) ────────────────────────────────────

      match /tasks/{id} {
        allow read: if isMember(houseId);
        allow create, update: if isMemberAfter(houseId) && validTask(request.resource.data);
        // na zawsze – tylko z kosza („Opróżnij kosz”); autor – także przeniesienie do „Tylko ja”
        allow delete: if isMember(houseId)
          && (resource.data.deleted == true || resource.data.createdBy == me() || isOwner(houseId));
      }

      // ── Rodzaje wydarzeń ──────────────────────────────────────────────────

      match /eventTypes/{id} {
        allow read: if isMember(houseId);
        allow create: if isMemberAfter(houseId) && validEventType(request.resource.data)
          // wbudowane systemowe („Termin zadania”) – tylko przy zakładaniu domu
          && (request.resource.data.system == false || houseCreatedNow(houseId));
        allow update: if isMember(houseId) && validEventType(request.resource.data)
          && request.resource.data.system == resource.data.system;
        // wbudowany („Termin zadania”) – tylko razem z całym domem (ta sama paczka, założyciel)
        allow delete: if isMember(houseId) && (resource.data.system == false
          || (isOwner(houseId) && !existsAfter(/databases/$(database)/documents/houses/$(houseId))));
      }

      // ── Wydarzenia (kosz: deleted = true) ─────────────────────────────────

      match /events/{id} {
        allow read: if isMember(houseId);
        allow create, update: if isMemberAfter(houseId) && validEvent(request.resource.data);
        allow delete: if isMember(houseId)
          && (resource.data.deleted == true || resource.data.createdBy == me() || isOwner(houseId));
      }

      // ── Wpisy „co się stało” dla powiadomień (etap 6, docs/POWIADOMIENIA.md) ─────
      // Dopisuje domownik – tylko pod własnym kontem i z czasem serwera; nikt ich nie zmienia
      // ani nie usuwa (stare usuwa Worker kontem serwisowym).

      match /activity/{id} {
        allow read: if isMember(houseId);
        allow create: if isMember(houseId)
          && request.resource.data.keys().hasOnly(['kind', 'title', 'detail', 'date', 'actor', 'at'])
          && request.resource.data.kind in ['task-added', 'task-done', 'task-due-soon',
              'task-urgent', 'task-trashed', 'event-added', 'event-moved', 'event-trashed']
          && str(request.resource.data.title, 200)
          && strOrNull(request.resource.data.detail, 60)
          && (request.resource.data.date == null || isDay(request.resource.data.date))
          && request.resource.data.actor == me()
          && request.resource.data.at == request.time;
        allow update: if false;
        // usunięcie domu przez założyciela
        allow delete: if isOwner(houseId);
      }

      // ── „Tylko ja”: zadania i wydarzenia widoczne tylko dla autora (decyzja Hani 2026-10-25) ──
      // Zapisuje, czyta i usuwa wyłącznie sam autor, dopóki jest domownikiem; inni domownicy nie widzą.

      match /private/{uid}/tasks/{id} {
        allow read, delete: if isMember(houseId) && uid == me();
        allow create, update: if isMemberAfter(houseId) && uid == me()
          && validTask(request.resource.data) && request.resource.data.createdBy == me();
      }

      match /private/{uid}/events/{id} {
        allow read, delete: if isMember(houseId) && uid == me();
        allow create, update: if isMemberAfter(houseId) && uid == me()
          && validEvent(request.resource.data) && request.resource.data.createdBy == me();
      }

      // ── Zdjęcia (etap 9) ──────────────────────────────────────────────────
      // Nikt ich nie zmienia (update) – „Przenieś do…” to usunięcie i dodanie.

      match /photos/{id} {
        allow read: if isMember(houseId);
        allow create: if isMemberAfter(houseId)
          && validPhoto(houseId, '', id, request.resource.data)
          && ((request.resource.data.createdBy == me()
              && request.resource.data.createdAt == request.time
              && countersMoved(houseId, '', id, request.resource.data.size))
            // „Tylko ja” → „Wspólne” (autor zadania)
            || movedIn(houseId, me(), id, request.resource.data));
        allow update: if false;
        allow delete: if isMember(houseId)
          && (countersMoved(houseId, '', id, -resource.data.size)
            // „Wspólne” → „Tylko ja”
            || movedOut(houseId, me(), id)
            || houseClosing(houseId));
      }

      // pełna wersja – razem ze swoim kafelkiem (ta sama paczka)
      match /photoFull/{id} {
        allow read: if isMember(houseId);
        allow create: if validFull(request.resource.data)
          && !exists(photoPath(houseId, '', id))
          && existsAfter(photoPath(houseId, '', id));
        allow update: if false;
        allow delete: if isMember(houseId) && !existsAfter(photoPath(houseId, '', id));
      }

      match /private/{uid}/photos/{id} {
        allow read: if isMember(houseId) && uid == me();
        allow create: if isMemberAfter(houseId) && uid == me()
          && validPhoto(houseId, uid, id, request.resource.data)
          && ((request.resource.data.createdBy == me()
              && request.resource.data.createdAt == request.time
              && countersMoved(houseId, uid, id, request.resource.data.size))
            || movedIn(houseId, '', id, request.resource.data));
        allow update: if false;
        allow delete: if isMember(houseId) && uid == me()
          && (countersMoved(houseId, uid, id, -resource.data.size)
            || movedOut(houseId, '', id)
            || houseClosing(houseId));
      }

      match /private/{uid}/photoFull/{id} {
        allow read: if isMember(houseId) && uid == me();
        allow create: if uid == me() && validFull(request.resource.data)
          && !exists(photoPath(houseId, uid, id))
          && existsAfter(photoPath(houseId, uid, id));
        allow update: if false;
        allow delete: if isMember(houseId) && uid == me()
          && !existsAfter(photoPath(houseId, uid, id));
      }
    }

  }
}
